# =========================================================================
# SUSANNA — variáveis do docker-compose.yml (copie para .env na raiz)
# scripts/deploy_aws.sh gera este arquivo automaticamente se não existir.
# =========================================================================

# Domínio público servido pelo Caddy (HTTPS automático via Let's Encrypt).
# Vazio = Caddy responde em :80 sem TLS. Ex.: app.203.0.113.10.nip.io
DOMAIN=

# Modelo do Ollama (precisa ser baixado: docker compose exec ollama ollama pull <modelo>)
OLLAMA_MODEL=llama3.2:3b

# Obrigatória (o compose falha sem ela). Gere com: openssl rand -hex 32
INGESTION_API_KEY=troque-por-um-valor-gerado-com-openssl-rand-hex-32

# Origens permitidas no CORS (ex.: https://app.203.0.113.10.nip.io)
CORS_ORIGINS=

# Timeout (s) das chamadas ao LLM — inferência em CPU é lenta
LLM_TIMEOUT_S=120
