# Copie para .env e ajuste se necessário
ENVIRONMENT=development
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_S=30
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_THRESHOLD=0.74
EMBEDDING_MAX_SEQ_LENGTH=256
GUARDRAIL_MODEL_URI=models:/susana-guardrail@champion
# GUARDRAIL_ENABLED_ML=true
# GUARDRAIL_THRESHOLD=0.4
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# LGPD: true grava o texto das perguntas no MLflow (padrão: só hash)
# MLFLOW_LOG_QUERY_TEXT=false
