Total de Doses = COUNTROWS('Vacinas')

Estabelecimentos = DISTINCTCOUNT('Vacinas'[i_estab_cnes])

Regiões Administrativas = DISTINCTCOUNT('Vacinas'[i_ra_ses_desc])

Vacinas Distintas = DISTINCTCOUNT('Vacinas'[i_imunobiologico])

Dias com Registro = DISTINCTCOUNT('Vacinas'[i_dt_inicial_atendimento])

Doses por Estabelecimento = DIVIDE([Total de Doses], [Estabelecimentos])

Percentual Feminino =
DIVIDE(
    CALCULATE([Total de Doses], 'Vacinas'[i_sexo] = "Feminino"),
    [Total de Doses]
)

Doses Menores de 5 Anos =
CALCULATE(
    [Total de Doses],
    'Vacinas'[i_faixa_etaria] IN {
        "Menos de 01 ano", "01 ano", "02 anos", "03 anos", "04 anos"
    }
)

Percentual Menores de 5 Anos = DIVIDE([Doses Menores de 5 Anos], [Total de Doses])

Doses 60 Mais =
CALCULATE(
    [Total de Doses],
    'Vacinas'[i_faixa_etaria] IN {
        "60 a 64 anos", "65 a 69 anos", "70 a 74 anos", "75 a 79 anos", "80 anos ou mais"
    }
)

Percentual Rotina =
DIVIDE(
    CALCULATE([Total de Doses], 'Vacinas'[i_estrategia_vacinacao] = "ROTINA"),
    [Total de Doses]
)

Doses Viajantes = CALCULATE([Total de Doses], 'Vacinas'[i_viajante] = 1)

Doses Comunicantes Hanseníase =
CALCULATE([Total de Doses], 'Vacinas'[i_comunicante_hanseniase] = 1)

Registros Sem Região =
CALCULATE(
    [Total de Doses],
    ISBLANK('Vacinas'[i_desc_regiao_saude])
)

Registros Fora da Competência =
CALCULATE(
    [Total de Doses],
    MONTH('Vacinas'[i_dt_inicial_atendimento]) <> 8
        || YEAR('Vacinas'[i_dt_inicial_atendimento]) <> 2026
)

Data do Último Registro = MAX('Vacinas'[i_dt_inicial_atendimento])