APP_NAME=Susana API
APP_VERSION=0.2.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/susana

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768

# Opcional: CKAN real ou ambiente de demonstração.
CKAN_BASE_URL=

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
